	measure 'Total Customers' = COUNTROWS('Telco Churn')
		formatString: #,0
		displayFolder: Key Metrics
		lineageTag: a072a58e-b0b0-47a4-a8dc-ae74c6690737

	measure 'Churned Customers' = CALCULATE([Total Customers], 'Telco Churn'[churn] = "Yes")
		formatString: #,0
		displayFolder: Key Metrics
		lineageTag: dffdae00-b6c5-46b1-befc-d96c39a9f112

	measure 'Churn Rate' = DIVIDE([Churned Customers], [Total Customers])
		formatString: 0.0%
		displayFolder: Key Metrics
		lineageTag: c6407191-4a8e-48a1-b732-6c4b92f3b872

	measure 'Average Tenure' = AVERAGE('Telco Churn'[tenure])
		formatString: 0.0
		displayFolder: Key Metrics
		lineageTag: ce568449-f72a-4468-9f57-ec3d14d0f572

	measure 'Average Monthly Charges' = AVERAGE('Telco Churn'[monthly_charges])
		formatString: $#,0.00
		displayFolder: Key Metrics
		lineageTag: 720a70d9-6524-4f6e-afb3-f90651ae2636

	measure 'Total Charges' = SUM('Telco Churn'[total_charges])
		formatString: $#,0
		displayFolder: Key Metrics
		lineageTag: bf0d0b8e-4397-4e0d-934c-d87719cb672a

